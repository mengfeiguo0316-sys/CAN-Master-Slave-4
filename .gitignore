# ==========================================
# 1. 编译构建输出目录（体积大且每次重新生成）
# ==========================================
build/
bin/
out/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
compile_commands.json
*.ninja
*.ninja_deps
*.ninja_log

# 嵌入式编译二进制产物
*.elf
*.bin
*.hex
*.map
*.o
*.obj
*.d
*.a

# ==========================================
# 2. ST 官方 VSCode 扩展及临时配置
# ==========================================
.settings/
*.store.json

# ==========================================
# 3. 编辑器及 Clangd 索引缓存
# ==========================================
.cache/
.clangd/

# 个人工作区与历史状态
.vscode/*
# 保留项目必需的调试、任务与环境模板文件
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/settings.json
# 忽略个人私有配置（如果有）
.vscode/*.log

# 仓库【根目录】的 .vscode 为本机个人配置（含绝对路径），不共享给团队
# 开头的斜杠表示只匹配仓库根目录，不影响各节点子目录（如 F103_Salve1/.vscode/）
/.vscode/

# ==========================================
# 4. 操作系统临时文件
# ==========================================
.DS_Store
Thumbs.db
Desktop.ini

#文件递归生效管所有文件夹